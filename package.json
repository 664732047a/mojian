{
  "name": "mojian",
  "productName": "墨笺",
  "version": "1.1.0",
  "description": "安静、流畅、完全本地的 Markdown 写作空间",
  "author": "Mojian",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/copy-assets.mjs",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:app": "node scripts/smoke-test.mjs",
    "test:workspace": "node scripts/workspace-smoke-test.mjs",
    "package": "npm run build && electron-builder --mac dmg --arm64",
    "package:dir": "npm run build && electron-builder --mac dir --arm64"
  },
  "dependencies": {
    "vditor": "3.11.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "vite": "^6.4.1"
  },
  "build": {
    "appId": "local.mojian.editor",
    "productName": "墨笺",
    "artifactName": "Mojian-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "darkModeSupport": true,
      "extendInfo": {
        "CFBundleDisplayName": "墨笺",
        "NSHumanReadableCopyright": "© 2026 Mojian. Built with open-source software.",
        "NSHighResolutionCapable": true
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "name": "Markdown 文稿",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "dmg": {
      "title": "安装墨笺",
      "window": {
        "width": 560,
        "height": 380
      },
      "iconSize": 104,
      "contents": [
        {
          "x": 160,
          "y": 170
        },
        {
          "x": 400,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
